# Where the shipper quote form (/contact/) sends its JSON (agree on this with the backend developer).
# Leave empty to keep the form in preview mode: nothing is sent anywhere.
PUBLIC_QUOTE_ENDPOINT=

# Where the driver application form (/careers/#apply) sends its JSON. Empty = preview mode.
PUBLIC_APPLY_ENDPOINT=

# "true" adds <meta name="robots" content="noindex"> (used for the GitHub Pages preview).
PUBLIC_NOINDEX=
