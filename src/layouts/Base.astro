---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { company, fullAddress } from '../data/site';
import { url } from '../lib/url';

interface Preload { srcset: string; sizes: string; media?: string }
interface Props {
  title: string;
  description: string;
  current?: 'home' | 'services' | 'fleet' | 'careers' | 'about' | 'contact' | 'legal' | 'other';
  noindex?: boolean;
  preload?: Preload[];
}

const { title, description, current = 'other', noindex = false, preload = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const hideFromSearch = noindex || import.meta.env.PUBLIC_NOINDEX === 'true';
const fontUrl = url('fonts/archivo-latin-wght.woff2');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  foundingDate: company.founded,
  name: company.name,
  legalName: company.legalName,
  url: Astro.site?.href,
  telephone: company.phone,
  email: company.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: company.street,
    addressLocality: company.city,
    addressRegion: company.state,
    postalCode: company.zip,
    addressCountry: 'US',
  },
  description: `Freight, long-haul trucking and last-mile delivery across 48 states from ${fullAddress}.`,
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Day/night theme before first paint: the visitor's saved choice, otherwise the system setting. -->
    <script is:inline>(function(){var t;try{t=localStorage.getItem('lk-theme')}catch(e){}if(t!=='dark'&&t!=='light'){t=window.matchMedia&&window.matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light'}document.documentElement.setAttribute('data-theme',t)})();</script>
    <title>{title}</title>
    <meta name="description" content={description} />
    {hideFromSearch ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#0e0e10" />
    <link rel="icon" type="image/png" sizes="32x32" href={url('brand/favicon-32.png')} />
    <link rel="apple-touch-icon" href={url('brand/apple-touch-icon.png')} />
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin />
    {preload.map((p) => (
      <link rel="preload" as="image" imagesrcset={p.srcset} imagesizes={p.sizes} media={p.media} fetchpriority="high" />
    ))}
    <style is:inline set:html={`@font-face{font-family:'Archivo';src:url('${fontUrl}') format('woff2');font-weight:100 900;font-style:normal;font-display:swap}`}></style>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={company.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_US" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />

    <!-- Phone links (tel:) always open the phone's default Phone app on phones and tablets.
         Only on a computer without touch, where nothing would open, the click copies the number and says so. -->
    <div class="toast" id="call-toast" role="status" aria-live="polite" data-phone={company.phone} hidden></div>
    <script>
      const toast = document.getElementById('call-toast');
      const canCall = () =>
        navigator.maxTouchPoints > 0 ||
        window.matchMedia('(any-pointer: coarse)').matches ||
        /Android|iPhone|iPad|iPod|Mobile/i.test(navigator.userAgent);
      let timer: number | undefined;
      if (toast) {
        document.addEventListener('click', async (e) => {
          const link = (e.target as Element | null)?.closest?.('a[href^="tel:"]');
          if (!link || canCall()) return; // phone or tablet: let the default Phone app open
          e.preventDefault();
          const phone = toast.dataset.phone || link.getAttribute('href')!.slice(4);
          let copied = false;
          try { await navigator.clipboard.writeText(phone); copied = true; } catch { /* clipboard blocked */ }
          toast.innerHTML = copied
            ? `<strong>Number copied: ${phone}</strong><span>Call dispatch from your phone, 24/7.</span>`
            : `<strong>Call dispatch: ${phone}</strong><span>We answer 24/7.</span>`;
          toast.hidden = false;
          window.clearTimeout(timer);
          timer = window.setTimeout(() => { toast.hidden = true; }, 4500);
        });
      }
    </script>
  </body>
</html>
